# Public URL of this site (used for canonical URLs, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Spring Boot API base URL, no trailing slash. Used by the browser (contact form)
# and by the server when rendering projects, skills and experience.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional: server-only API URL if the server should reach the API on a different
# address than the browser (e.g. a private network). Defaults to NEXT_PUBLIC_API_URL.
# API_URL=
