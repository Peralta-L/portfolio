# PostgreSQL connection (defaults match docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portfolio
DB_USER=portfolio
DB_PASSWORD=portfolio
DB_POOL_SIZE=5

# Comma-separated browser origins allowed to call the API (your Vercel domain[s])
ALLOWED_ORIGINS=http://localhost:3000

# Contact form throttling per client IP (ISO-8601 duration)
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW=PT1H

# HTTP port (Render injects this automatically)
PORT=8080
